# =====================================================================
# App Maratona 21 — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e cadastre as MESMAS na Vercel
# (Project → Settings → Environment Variables). Nunca commite valores reais.
# =====================================================================

# --- Supabase (Project Settings → API) --------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOMENTE SERVIDOR. Nunca use o prefixo NEXT_PUBLIC_ nesta chave.
SUPABASE_SERVICE_ROLE_KEY=

# --- Hotmart (Webhook 2.0.0) ------------------------------------------
# Hottok da sua conta Hotmart (enviado no header X-HOTMART-HOTTOK)
HOTMART_HOTTOK=
# ucode(s) do(s) produto(s) que liberam acesso, separados por vírgula
HOTMART_ALLOWED_PRODUCT_UCODES=
# Opcional: só libera para estas ofertas (vazio = qualquer oferta do produto)
HOTMART_ALLOWED_OFFER_CODES=

# --- Administração -----------------------------------------------------
ADMIN_EMAILS=gisele@nutrigiselesilveira.com.br,alinenmaia@outlook.com

# --- Endereço do app ---------------------------------------------------
# URL pública completa, sem barra no final
NEXT_PUBLIC_APP_URL=https://nutrigiselesilveira.com.br/app
# Subcaminho onde o app roda ("/app"), ou vazio se ficar na raiz de um domínio/subdomínio.
# É lido no BUILD: ao mudar, faça um novo deploy.
NEXT_PUBLIC_BASE_PATH=/app

# --- Suporte e textos legais ------------------------------------------
SUPPORT_EMAIL=mentoriaemagrecimentoeficiente@gmail.com
# Opcional: link de WhatsApp/central de ajuda (tem prioridade sobre o e-mail)
SUPPORT_URL=
PRIVACY_POLICY_URL=
TERMS_URL=

# --- E-mail de boas-vindas (opcional) ----------------------------------
# Sem estas variáveis, a compra é processada normalmente e nenhum e-mail é enviado.
RESEND_API_KEY=
# Ex.: Maratona 21 <app@nutrigiselesilveira.com.br>  (domínio verificado no Resend)
EMAIL_FROM=
